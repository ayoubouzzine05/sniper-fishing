# ---------------------------------------------------------------------------
# Sniper Fishing — environment variables
# Copy this file to .env.local and fill in what you need.
#
# The application works WITHOUT any of these variables (guest mode, local
# persistence, free Open-Meteo APIs that require no key).
# ---------------------------------------------------------------------------

# --- Optional: Supabase cloud sync (accounts, sync of spots & logbook) ------
# Leave unset to run fully local. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: port for `npm run dev` / `npm start` --------------------------
# PORT=3000
